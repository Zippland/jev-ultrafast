TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional, independent CU service. Keep its console running; this command only opens an MCP session.
# Quote the JSON array in .env; use the absolute path to your CU checkout's public MCP entry.
CU_MCP_COMMAND='["node","/absolute/path/to/codex-CU/src/mcp.mjs"]'
# Official-runtime backend used by the mixed-app benchmark; remains a separate MCP service.
CU_RELAY_COMMAND='["cua-relay","serve"]'
# Optional for `uv run jev-voice`; defaults to the existing local NeraJelly runtime and Qwen3-ASR weights.
# This executable needs numpy, mlx-audio, and sherpa-onnx. No application service is imported or started.
# VOICE_PYTHON="/absolute/path/to/asr-venv/bin/python3"
# VOICE_MODEL_PATH="/absolute/path/to/Qwen3-ASR-model-directory"
# VOICE_PRELOAD=0  # Optional: disable model-only startup warmup to save resident memory.
